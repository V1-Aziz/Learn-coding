# Server
PORT=3000
NODE_ENV=development

# PostgreSQL connection string used by Prisma
# Local docker:    postgresql://postgres:postgres@localhost:5432/my_litters
# Hosted (Neon):   postgresql://USER:PASS@HOST.neon.tech/my_litters?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my_litters

# JWT
JWT_SECRET=change_me_in_production_min_32_chars_______
JWT_EXPIRES_IN=7d

# CORS: comma-separated browser origins allowed to call the API.
# Leave unset in development to allow all origins.
# CORS_ORIGINS=https://app.mylitters.com,https://admin.mylitters.com

# Payment gateway (Tap). Leave unset to run the gateway in simulated mode
# (no external calls, no real charges). Set the test key to go live later.
# TAP_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
