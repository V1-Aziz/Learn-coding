// Prisma schema for My Litters
// Reference SQL: ../db/schema.sql
//
// Run after editing:
//   npx prisma migrate dev --name <change_name>
//   npx prisma generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------- Enums --------------------
enum UserRole {
  customer
  staff
  admin
}

enum FuelType {
  p91
  p95
  diesel
}

enum CardStatus {
  active
  blocked
  lost
}

enum SubStatus {
  active
  paused
  canceled
}

enum TxnStatus {
  approved
  declined
  voided
}

enum InvoiceStatus {
  open
  due
  paid
  overdue
}

enum PaymentMethod {
  card
  bank
  cash
  wallet
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

// BNPL: a plan purchase split into 1 (paid-in-full) to 4 monthly installments.
enum InstallmentPlanStatus {
  active
  completed
  canceled
}

enum InstallmentStatus {
  pending
  paid
}

// -------------------- Models --------------------

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique // case-handling done in app layer (lowercased)
  phone         String?  @unique
  passwordHash  String   @map("password_hash")
  fullName      String   @map("full_name")
  nationalId    String?  @unique @map("national_id")
  role          UserRole @default(customer)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicles         Vehicle[]
  cards            Card[]
  subscriptions    Subscription[]
  transactions     Transaction[]
  invoices         Invoice[]
  payments         Payment[]
  installmentPlans InstallmentPlan[]

  @@map("users")
}

model Vehicle {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  plateNumber  String   @map("plate_number")
  make         String?
  model        String?
  year         Int?
  fuelType     FuelType @map("fuel_type")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, plateNumber])
  @@index([userId])
  @@map("vehicles")
}

model Plan {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  fuelType            FuelType @map("fuel_type")
  monthlyLitersLimit  Int      @map("monthly_liters_limit")
  pricePerLiter       Decimal  @map("price_per_liter") @db.Decimal(12, 3)
  monthlyFee          Decimal  @default(0) @map("monthly_fee") @db.Decimal(12, 3)
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subscriptions       Subscription[]

  @@map("plans")
}

model Subscription {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  planId       String    @map("plan_id") @db.Uuid
  status       SubStatus @default(active)
  creditLimit  Decimal   @map("credit_limit") @db.Decimal(12, 3)
  billingDay   Int       @default(1) @map("billing_day") @db.SmallInt
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endsAt       DateTime? @map("ends_at") @db.Timestamptz(6)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             Plan              @relation(fields: [planId], references: [id])
  transactions     Transaction[]
  invoices         Invoice[]
  installmentPlans InstallmentPlan[]

  @@index([userId])
  @@map("subscriptions")
}

model Card {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  cardUid   String     @unique @map("card_uid")
  label     String?
  status    CardStatus @default(active)
  linkedAt  DateTime   @default(now()) @map("linked_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("cards")
}

model Station {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  city      String?
  lat       Decimal? @db.Decimal(9, 6)
  lng       Decimal? @db.Decimal(9, 6)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  transactions Transaction[]

  @@map("stations")
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  subscriptionId  String        @map("subscription_id") @db.Uuid
  periodStart     DateTime      @map("period_start") @db.Date
  periodEnd       DateTime      @map("period_end") @db.Date
  subtotal        Decimal       @default(0) @db.Decimal(12, 3)
  monthlyFee      Decimal       @default(0) @map("monthly_fee") @db.Decimal(12, 3)
  total           Decimal       @default(0) @db.Decimal(12, 3)
  status          InvoiceStatus @default(open)
  dueDate         DateTime      @map("due_date") @db.Date
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription  @relation(fields: [subscriptionId], references: [id])
  transactions Transaction[]
  payments     Payment[]

  @@unique([subscriptionId, periodStart])
  @@index([userId])
  @@index([status])
  @@map("invoices")
}

model Transaction {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  cardId          String     @map("card_id") @db.Uuid
  subscriptionId  String     @map("subscription_id") @db.Uuid
  stationId       String?    @map("station_id") @db.Uuid
  vehicleId       String?    @map("vehicle_id") @db.Uuid
  liters          Decimal    @db.Decimal(8, 3)
  pricePerLiter   Decimal    @map("price_per_liter") @db.Decimal(12, 3)
  totalAmount     Decimal    @map("total_amount") @db.Decimal(12, 3)
  fuelType        FuelType   @map("fuel_type")
  status          TxnStatus  @default(approved)
  declineReason   String?    @map("decline_reason")
  invoiceId       String?    @map("invoice_id") @db.Uuid
  tappedAt        DateTime   @default(now()) @map("tapped_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  card         Card         @relation(fields: [cardId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  station      Station?     @relation(fields: [stationId], references: [id])
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id])
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])

  @@index([userId, tappedAt(sort: Desc)])
  @@index([subscriptionId])
  @@index([invoiceId])
  @@index([cardId])
  @@map("transactions")
}

model Payment {
  id         String         @id @default(uuid()) @db.Uuid
  invoiceId  String         @map("invoice_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  amount     Decimal        @db.Decimal(12, 3)
  method     PaymentMethod
  reference  String?
  status     PaymentStatus  @default(pending)
  paidAt     DateTime?      @map("paid_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice    Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([userId])
  @@map("payments")
}

// A BNPL agreement created at checkout for a plan purchase. The plan's
// monthly total is financed over `months` equal installments (months = 1
// means paid in full). The first installment is settled at checkout, which
// is what activates the subscription.
model InstallmentPlan {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String                @map("user_id") @db.Uuid
  subscriptionId String                @map("subscription_id") @db.Uuid
  totalAmount    Decimal               @map("total_amount") @db.Decimal(12, 3)
  months         Int                   @db.SmallInt
  status         InstallmentPlanStatus @default(active)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  installments Installment[]

  @@index([userId])
  @@index([subscriptionId])
  @@map("installment_plans")
}

model Installment {
  id                String            @id @default(uuid()) @db.Uuid
  installmentPlanId String            @map("installment_plan_id") @db.Uuid
  seq               Int               @db.SmallInt
  amount            Decimal           @db.Decimal(12, 3)
  dueDate           DateTime          @map("due_date") @db.Date
  status            InstallmentStatus @default(pending)
  paidAt            DateTime?         @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  installmentPlan InstallmentPlan @relation(fields: [installmentPlanId], references: [id], onDelete: Cascade)

  @@index([installmentPlanId])
  @@map("installments")
}
